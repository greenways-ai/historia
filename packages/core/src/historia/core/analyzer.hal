(ns historia.core.analyzer)

(def protocol-version "1.0")
(def analyzer-schema "historia.analyzer/0-alpha")

(defn make-descriptor
  [id name languages extensions]
  {"schema" analyzer-schema
   "id" id
   "name" name
   "protocolVersion" protocol-version
   "implementation" "external-worker"
   "languages" languages
   "extensions" extensions})

(def javascript
  (make-descriptor
   "javascript"
   "historia-typescript"
   ["javascript" "jsx" "typescript" "tsx"]
   [".js" ".jsx" ".mjs" ".cjs" ".ts" ".tsx"]))

(def python
  (make-descriptor
   "python"
   "historia-python"
   ["python"]
   [".py" ".pyi" ".pyw"]))

(def clojure
  (make-descriptor
   "clojure"
   "historia-clojure"
   ["clojure" "babashka"]
   [".clj" ".bb"]))

(def hara
  (make-descriptor
   "hara"
   "historia-hara"
   ["hara"]
   [".hal"]))

(def descriptors
  [javascript python clojure hara])

(def analyzer-by-language
  {"javascript" javascript
   "jsx" javascript
   "typescript" javascript
   "tsx" javascript
   "python" python
   "clojure" clojure
   "babashka" clojure
   "hara" hara})

(defn for-language
  [language]
  (get analyzer-by-language language))

(defn request
  [request-id language path blob-oid source]
  {"protocol_version" protocol-version
   "request_id" request-id
   "op" "analyze"
   "language" language
   "path" path
   "blob_oid" blob-oid
   "source" source
   "config" {}})
