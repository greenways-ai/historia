(ns historia.core.analyzer)

(def protocol-version "1.0")
(def analyzer-schema "historia.analyzer/0-alpha")

(def javascript
  {"schema" analyzer-schema
   "id" "javascript"
   "name" "historia-typescript"
   "protocolVersion" protocol-version
   "implementation" "external-worker"
   "languages" ["javascript" "jsx" "typescript" "tsx"]
   "extensions" [".js" ".jsx" ".mjs" ".cjs" ".ts" ".tsx"]})

(def python
  {"schema" analyzer-schema
   "id" "python"
   "name" "historia-python"
   "protocolVersion" protocol-version
   "implementation" "external-worker"
   "languages" ["python"]
   "extensions" [".py" ".pyi" ".pyw"]})

(def clojure
  {"schema" analyzer-schema
   "id" "clojure"
   "name" "historia-clojure"
   "protocolVersion" protocol-version
   "implementation" "external-worker"
   "languages" ["clojure" "babashka"]
   "extensions" [".clj" ".bb"]})

(def hara
  {"schema" analyzer-schema
   "id" "hara"
   "name" "historia-hara"
   "protocolVersion" protocol-version
   "implementation" "external-worker"
   "languages" ["hara"]
   "extensions" [".hal"]})

(def descriptors
  [javascript python clojure hara])

(def analyzer-by-language
  {"javascript" javascript
   "jsx" javascript
   "typescript" javascript
   "tsx" javascript
   "python" python
   "clojure" clojure
   "babashka" clojure
   "hara" hara})

(defn for-language
  [language]
  (get analyzer-by-language language))

(defn request
  [request-id language path blob-oid source]
  {"protocol_version" protocol-version
   "request_id" request-id
   "op" "analyze"
   "language" language
   "path" path
   "blob_oid" blob-oid
   "source" source
   "config" {}})
