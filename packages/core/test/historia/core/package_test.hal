(ns historia.core.package-test
  (:require [historia.core.analyzer :as analyzer]
            [historia.core.artifact :as artifact]
            [historia.core.index :as index]))

[(test-check
  "the package exposes the artifact schema"
  (get
   (artifact/create "artifact:1" "example" {} "revision:1" [])
   "schema")
  "historia.artifact/0-alpha")
 (test-check
  "the package exposes all four analyser families"
  (count analyzer/descriptors)
  4)
 (test-check
  "the package resolves a supported analyser"
  (get (analyzer/for-language "python") "id")
  "python")
 (test-check
  "TypeScript selects the JavaScript analyser family"
  (get (analyzer/for-language "typescript") "id")
  "javascript")
 (test-check
  "portable analyser descriptors contain no process command"
  (get analyzer/python "command")
  nil)
 (test-check
  "the package abstains for unknown languages"
  (analyzer/for-language "unknown")
  nil)
 (test-check
  "the package index stores independent record families"
  (index/counts
   (index/put-link
    (index/put-analysis
     (index/put-artifact
      (index/create)
      (artifact/create "artifact:1" "example" {} "revision:1" []))
     (artifact/analysis "analysis:1" "artifact:1" nil "python" {}))
    (artifact/link "link:1" "artifact:1" "artifact:2" "related" {})))
  {"artifacts" 1
   "analyses" 1
   "links" 1})]
