#!/usr/bin/env sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
RUNTIME=${HARA_RUST_FULL:-}

if [ -z "$RUNTIME" ] && [ -x "$ROOT/target/bin/hara-rust-full" ]; then
  RUNTIME="$ROOT/target/bin/hara-rust-full"
fi
if [ -z "$RUNTIME" ]; then
  RUNTIME=$(command -v hara-rust-full || true)
fi
if [ -z "$RUNTIME" ]; then
  RUNTIME=$("$ROOT/bin/build-hara-rust-full")
fi

exec "$RUNTIME" analyzer "$ROOT/analyzer.hal"
