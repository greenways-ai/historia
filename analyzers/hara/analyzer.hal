;; Historia's Hara-side Clojure/Babashka analyzer.
;;
;; The Rust boundary supplies only a compact, non-evaluated Hara reader tree:
;;   [nodes roots]
;; where every node is [shape-code token-id children]. Token IDs 0..45 are the
;; stable analyzer vocabulary documented below; source-specific tokens follow.
;; Namespace/import discovery, definition classification, call extraction and
;; structural shaping all execute here through hara-rust-full whole-Wasm.
;;
;; Stable token vocabulary:
;;   0 def           12 fn          24 case       36 doto
;;   1 defonce       13 fn*         25 do         37 locking
;;   2 defn          14 let         26 quote      38 with-open
;;   3 defn-         15 letfn       27 var        39 binding
;;   4 defmacro      16 loop        28 set!       40 for
;;   5 defmulti      17 recur       29 try        41 doseq
;;   6 defmethod     18 if          30 catch      42 dotimes
;;   7 defprotocol   19 if-not      31 finally    43 comment
;;   8 defrecord     20 when        32 throw      44 require
;;   9 deftype       21 when-not    33 new        45 :require
;;  10 deftest       22 cond        34 .
;;  11 ns            23 condp       35 ..

(defn ^{:schema [:fn [:any :any] :any]}
  append
  [values value]
  (assoc values (count values) value))

(defn ^{:schema [:fn [:any :int] :any]}
  node-at
  [nodes node-id]
  (nth nodes node-id))

(defn ^{:schema [:fn [:any :int] :int]}
  int-at
  [values index]
  (nth values index))

(defn ^{:schema [:fn [:any :int :int] :any]}
  node-field
  [nodes node-id field]
  (nth (node-at nodes node-id) field))

(defn ^{:schema [:fn [:any :int] :int]}
  node-shape-code
  [nodes node-id]
  (node-field nodes node-id 0))

(defn ^{:schema [:fn [:any :int] :int]}
  node-token
  [nodes node-id]
  (node-field nodes node-id 1))

(defn ^{:schema [:fn [:any :int] :any]}
  node-children
  [nodes node-id]
  (node-field nodes node-id 2))

(defn ^{:schema [:fn [:int] :int]}
  definition-kind
  [token]
  (if (= token 0)
    1
    (if (= token 1)
      1
      (if (= token 2)
        2
        (if (= token 3)
          2
          (if (= token 4)
            3
            (if (= token 5)
              4
              (if (= token 6)
                5
                (if (= token 7)
                  6
                  (if (= token 8)
                    7
                    (if (= token 9)
                      8
                      (if (= token 10) 9 0))))))))))))

(defn ^{:schema [:fn [:int] :int]}
  non-call
  [token]
  (if (< token 44) 1 0))

(defn ^{:schema [:fn [:int] :int]}
  special
  [token]
  (if (< token 10)
    1
    (if (< token 12)
      0
      (if (< token 36) 1 0))))

(defn ^{:schema [:fn [:int] :int]}
  role
  [token]
  (if (= token 11)
    1
    (if (= token 44)
      2
      (if (= token 45) 3 0))))

(defn ^{:schema [:fn [:int] :int]}
  private-definition
  [token]
  (if (= token 3) 1 0))

(defn ^{:schema [:fn [:any :any :int :any] :any]}
  shape-children
  [nodes children index output]
  (if (< index (count children))
    (shape-children
     nodes
     children
     (+ index 1)
     (append output (shape-node nodes (int-at children index))))
    output))

(defn ^{:schema [:fn [:any :int :int] :any]}
  shape-prefix
  [nodes node-id output-tag]
  (let [children (node-children nodes node-id)]
    (if (< 0 (count children))
      [output-tag (shape-node nodes (int-at children 0))]
      [output-tag nil])))

(defn ^{:schema [:fn [:any :int] :any]}
  shape-list
  [nodes node-id]
  (let [children (node-children nodes node-id)]
    (if (< 0 (count children))
      (let [head-id (int-at children 0)
            head-token (node-token nodes head-id)
            head-shape (if (= 1 (special head-token))
                         [100 head-token]
                         [101])]
        (shape-children nodes children 1 [head-shape]))
      [[101]])))

(defn ^{:schema [:fn [:any :int] :any]}
  shape-node
  [nodes node-id]
  (let [shape-code (node-shape-code nodes node-id)
        token (node-token nodes node-id)
        children (node-children nodes node-id)]
    (if (= shape-code 10)
      (shape-list nodes node-id)
      (if (= shape-code 11)
        (shape-children nodes children 0 [102])
        (if (= shape-code 12)
          (shape-children nodes children 0 [103])
          (if (= shape-code 13)
            (shape-children nodes children 0 [104])
            (if (= shape-code 14)
              (shape-children nodes children 0 [105])
              (if (= shape-code 15)
                (shape-prefix nodes node-id 106)
                (if (= shape-code 16)
                  (shape-prefix nodes node-id 107)
                  (if (= shape-code 17)
                    (shape-prefix nodes node-id 108)
                    (if (= shape-code 18)
                      (shape-prefix nodes node-id 109)
                      (if (= shape-code 19)
                        (shape-prefix nodes node-id 110)
                        (if (= shape-code 1)
                          [115]
                          (if (= shape-code 2)
                            [112]
                            (if (= shape-code 3)
                              [113]
                              (if (= shape-code 4)
                                [114]
                                [115]))))))))))))))))

(defn ^{:schema [:fn [:any :any :int] :int]}
  namespace-from-roots
  [nodes roots index]
  (if (< index (count roots))
    (let [root-id (int-at roots index)
          children (node-children nodes root-id)]
      (if (= 10 (node-shape-code nodes root-id))
        (if (< 1 (count children))
          (if (= 1 (role (node-token nodes (int-at children 0))))
            (node-token nodes (int-at children 1))
            (namespace-from-roots nodes roots (+ index 1)))
          (namespace-from-roots nodes roots (+ index 1)))
        (namespace-from-roots nodes roots (+ index 1))))
    -1))

(defn ^{:schema [:fn [:any :any :int :any] :any]}
  append-clause-imports
  [nodes clause-children index output]
  (if (< index (count clause-children))
    (append-clause-imports
     nodes
     clause-children
     (+ index 1)
     (append output (int-at clause-children index)))
    output))

(defn ^{:schema [:fn [:any :any :int :any] :any]}
  imports-from-ns-children
  [nodes ns-children index output]
  (if (< index (count ns-children))
    (let [clause-id (int-at ns-children index)
          clause-children (node-children nodes clause-id)]
      (if (= 10 (node-shape-code nodes clause-id))
        (if (< 0 (count clause-children))
          (let [clause-role (role (node-token nodes (int-at clause-children 0)))]
            (if (= clause-role 2)
              (imports-from-ns-children
               nodes
               ns-children
               (+ index 1)
               (append-clause-imports nodes clause-children 1 output))
              (if (= clause-role 3)
                (imports-from-ns-children
                 nodes
                 ns-children
                 (+ index 1)
                 (append-clause-imports nodes clause-children 1 output))
                (imports-from-ns-children nodes ns-children (+ index 1) output))))
          (imports-from-ns-children nodes ns-children (+ index 1) output))
        (imports-from-ns-children nodes ns-children (+ index 1) output)))
    output))

(defn ^{:schema [:fn [:any :any :int] :any]}
  imports-from-roots
  [nodes roots index]
  (if (< index (count roots))
    (let [root-id (int-at roots index)
          children (node-children nodes root-id)]
      (if (= 10 (node-shape-code nodes root-id))
        (if (< 0 (count children))
          (if (= 1 (role (node-token nodes (int-at children 0))))
            (imports-from-ns-children nodes children 1 [])
            (imports-from-roots nodes roots (+ index 1)))
          (imports-from-roots nodes roots (+ index 1)))
        (imports-from-roots nodes roots (+ index 1))))
    []))

(defn ^{:schema [:fn [:any :any :int] :int]}
  first-vector-child
  [nodes children index]
  (if (< index (count children))
    (let [child-id (int-at children index)]
      (if (= 11 (node-shape-code nodes child-id))
        child-id
        (first-vector-child nodes children (+ index 1))))
    -1))

(defn ^{:schema [:fn [:any :any :int :any] :any]}
  collect-definitions
  [nodes roots index output]
  (if (< index (count roots))
    (let [root-id (int-at roots index)
          children (node-children nodes root-id)]
      (if (= 10 (node-shape-code nodes root-id))
        (if (< 1 (count children))
          (let [head-id (int-at children 0)
                name-id (int-at children 1)
                head-token (node-token nodes head-id)
                kind (definition-kind head-token)
                name-token (node-token nodes name-id)]
            (if (< 0 kind)
              (if (< -1 name-token)
                (collect-definitions
                 nodes
                 roots
                 (+ index 1)
                 (append output
                         [root-id
                          head-token
                          name-token
                          (first-vector-child nodes children 2)
                          kind
                          (private-definition head-token)
                          (shape-node nodes root-id)]))
                (collect-definitions nodes roots (+ index 1) output))
              (collect-definitions nodes roots (+ index 1) output)))
          (collect-definitions nodes roots (+ index 1) output))
        (collect-definitions nodes roots (+ index 1) output)))
    output))

(defn ^{:schema [:fn [:any :any :int :int :any] :any]}
  collect-child-references
  [nodes children index definition-index output]
  (if (< index (count children))
    (collect-child-references
     nodes
     children
     (+ index 1)
     definition-index
     (collect-node-references
      nodes
      (int-at children index)
      definition-index
      output))
    output))

(defn ^{:schema [:fn [:any :int :int :any] :any]}
  collect-node-references
  [nodes node-id definition-index output]
  (let [shape-code (node-shape-code nodes node-id)
        children (node-children nodes node-id)
        next-output
        (if (= shape-code 10)
          (if (< 0 (count children))
            (let [head-id (int-at children 0)
                  head-token (node-token nodes head-id)]
              (if (= 0 (non-call head-token))
                (if (= 1 (node-shape-code nodes head-id))
                  output
                  (if (< -1 head-token)
                    (append output [definition-index head-token])
                    output))
                output))
            output)
          output)]
    (collect-child-references
     nodes
     children
     0
     definition-index
     next-output)))

(defn ^{:schema [:fn [:any :any :int :any] :any]}
  collect-references
  [nodes definitions index output]
  (if (< index (count definitions))
    (collect-references
     nodes
     definitions
     (+ index 1)
     (collect-node-references
      nodes
      (int-at (node-at definitions index) 0)
      index
      output))
    output))

(defn ^{:schema [:fn [:any] :any]}
  analyze
  [input]
  (let [nodes (node-at input 0)
        roots (node-at input 1)
        definitions (collect-definitions nodes roots 0 [])]
    [(namespace-from-roots nodes roots 0)
     (imports-from-roots nodes roots 0)
     definitions
     (collect-references nodes definitions 0 [])]))

0
