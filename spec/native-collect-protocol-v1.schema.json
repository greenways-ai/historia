{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://specs.hara-lang.io/historia/native-collect-protocol-v1.schema.json",
  "title": "Historia Collect Native Messaging Protocol v1",
  "oneOf": [
    {
      "title": "Request",
      "type": "object",
      "required": ["protocol_version", "request_id", "op"],
      "properties": {
        "protocol_version": { "const": "1.0" },
        "request_id": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "op": { "enum": ["ping", "capture", "status"] },
        "observation": { "$ref": "browser-observation-v1.schema.json" },
        "options": {
          "type": "object",
          "properties": {
            "index": { "type": "boolean" },
            "ref": { "type": ["string", "null"], "pattern": "^refs/historia/sources/" }
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "op": { "const": "capture" } },
            "required": ["op"]
          },
          "then": {
            "required": ["observation"],
            "properties": {
              "observation": { "$ref": "browser-observation-v1.schema.json" }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    {
      "title": "Response",
      "type": "object",
      "required": ["protocol_version", "request_id", "ok"],
      "properties": {
        "protocol_version": { "const": "1.0" },
        "request_id": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "ok": { "type": "boolean" },
        "result": {},
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": { "type": "string" },
            "message": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  ]
}
