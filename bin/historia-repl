#!/usr/bin/env sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
RUNTIME=${HARA_CLI:-}

usage() {
  cat <<'EOF'
Historia native Hara REPL

Usage:
  historia repl
  historia repl --resp [HARA_REPL_OPTIONS]
  historia repl --eval FORM

The default REPL is offline. Use --resp to start Hara's local RESP listener.
Other Hara terminal options are passed through, including --history,
--no-history, --no-splash, --no-color, --host and --port.

Inside the REPL:
  (require [historia.repl :as historia])
  (historia/describe)
EOF
}

resolve_runtime() {
  if [ -n "$RUNTIME" ]; then
    return
  fi
  if [ -x "$ROOT/target/bin/hara" ]; then
    RUNTIME="$ROOT/target/bin/hara"
    return
  fi
  RUNTIME=$(command -v hara || true)
  if [ -n "$RUNTIME" ]; then
    return
  fi
  sh "$ROOT/bin/build-hara-app" >/dev/null
  RUNTIME="$ROOT/target/bin/hara"
}

case "${1:-}" in
  --help|-h)
    usage
    exit 0
    ;;
  --eval)
    shift
    if [ "$#" -ne 1 ]; then
      echo "historia repl: --eval requires exactly one Hara form" >&2
      exit 2
    fi
    resolve_runtime
    exec "$RUNTIME" \
      --project "$ROOT" \
      --root "$ROOT" \
      --allow-file \
      --allow-process \
      eval "$1"
    ;;
  --eval=*)
    SOURCE=${1#--eval=}
    if [ -z "$SOURCE" ] || [ "$#" -ne 1 ]; then
      echo "historia repl: --eval requires exactly one Hara form" >&2
      exit 2
    fi
    resolve_runtime
    exec "$RUNTIME" \
      --project "$ROOT" \
      --root "$ROOT" \
      --allow-file \
      --allow-process \
      eval "$SOURCE"
    ;;
  --resp)
    shift
    resolve_runtime
    exec "$RUNTIME" \
      --project "$ROOT" \
      --root "$ROOT" \
      --allow-file \
      --allow-process \
      "$@" \
      repl
    ;;
  *)
    resolve_runtime
    exec "$RUNTIME" \
      --project "$ROOT" \
      --root "$ROOT" \
      --allow-file \
      --allow-process \
      --offline \
      "$@" \
      repl
    ;;
esac
