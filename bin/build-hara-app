#!/usr/bin/env sh
set -eu

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
HARA_REPOSITORY=${HARA_REPOSITORY:-https://github.com/hara-lang/hara.git}
# Immutable Hara substrate with hara-app plus the bundled hara-lite bootstrap.
HARA_APPLICATION_REV=${HARA_APPLICATION_REV:-2acd20cb5d1b0e1fb9d93496eb836c1bcbfd61da}
SOURCE_DIR=${HARA_SOURCE_DIR:-$ROOT/target/hara-runtime}
BUILD_DIR=${HARA_BUILD_DIR:-$ROOT/target/hara-build}
OUTPUT_DIR=${HARA_OUTPUT_DIR:-$ROOT/target/bin}
SHARE_DIR=${HARA_SHARE_DIR:-$ROOT/target/share/hara-lite}
REVISION_FILE="$OUTPUT_DIR/hara-application-revision.txt"

if [ -z "${HARA_SOURCE_DIR:-}" ]; then
  if [ ! -d "$SOURCE_DIR/.git" ]; then
    rm -rf "$SOURCE_DIR"
    git clone --filter=blob:none --no-checkout "$HARA_REPOSITORY" "$SOURCE_DIR"
  fi
  if ! git -C "$SOURCE_DIR" fetch --depth 1 origin "$HARA_APPLICATION_REV"; then
    echo "Historia Hara application dependency unavailable: $HARA_REPOSITORY@$HARA_APPLICATION_REV" >&2
    exit 1
  fi
  git -C "$SOURCE_DIR" checkout --detach --force FETCH_HEAD
fi

ACTUAL_REVISION=$(git -C "$SOURCE_DIR" rev-parse HEAD)
if [ "$ACTUAL_REVISION" != "$HARA_APPLICATION_REV" ]; then
  echo "Historia Hara application dependency mismatch: expected $HARA_APPLICATION_REV, got $ACTUAL_REVISION" >&2
  exit 1
fi

CARGO_TARGET_DIR="$BUILD_DIR" cargo build \
  --quiet \
  --release \
  --locked \
  --manifest-path "$SOURCE_DIR/core/rust/Cargo.toml" \
  --bin hara \
  --bin hara-lite \
  --bin hara-app

mkdir -p "$OUTPUT_DIR"
cp "$BUILD_DIR/release/hara" "$OUTPUT_DIR/hara"
cp "$BUILD_DIR/release/hara-lite" "$OUTPUT_DIR/hara-lite"
cp "$BUILD_DIR/release/hara-app" "$OUTPUT_DIR/hara-app"
chmod +x "$OUTPUT_DIR/hara" "$OUTPUT_DIR/hara-lite" "$OUTPUT_DIR/hara-app"

rm -rf "$SHARE_DIR"
mkdir -p "$SHARE_DIR"
cp "$SOURCE_DIR/core/project.edn" "$SHARE_DIR/project.edn"
cp -R "$SOURCE_DIR/core/lib" "$SHARE_DIR/lib"

printf '%s\n' "$ACTUAL_REVISION" > "$REVISION_FILE"
printf '%s\n' "$OUTPUT_DIR/hara-app"
