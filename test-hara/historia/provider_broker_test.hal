(ns historia.provider-broker-test
  (:require [historia.core.provider :as provider]
            [historia.provider.broker :as broker]
            [historia.provider.observation :as observation]
            [work.base :as work]))

(def fixture-descriptor
  (provider/descriptor
   "fixture"
   "0-alpha"
   ["discover" "pull" "observe" "status"]
   ["fixture.document"]
   ["document"]
   {"readOnly" true}))

(def fixture-registry
  (provider/register
   (provider/create-registry)
   fixture-descriptor))

(defn fixture-executor
  [request context]
  (observation/result
   request
   [(observation/observation
     "fixture:document-1:revision-1"
     "fixture.document"
     "document-1"
     "revision-1"
     "2026-08-19T12:00:00Z"
     "application/json"
     "{\"answer\":42}"
     {"title" "Fixture"})]
   {"generation" 1
    "cursor" "document-1"}
   {"claimed" true
    "evidence" "fixture"}
   []))

(def bound-broker
  (broker/bind
   (broker/create fixture-registry)
   "fixture"
   fixture-executor))

(def pull-request
  (provider/request
   "broker-request-1"
   "fixture"
   "pull"
   nil
   {"source" "fixture"}))

(def acquisition-spec
  (broker/acquisition-spec bound-broker "fixture"))

(def acquisition-operations
  (vec
   (map
    (fn [child]
      (get (work/work-spec child) :op))
    (:children acquisition-spec))))

(def default-executions (atom 0))

(defn default-executor
  [request context]
  (swap! default-executions inc)
  (fixture-executor request context))

(def default-broker
  (broker/bind
   (broker/create fixture-registry)
   "fixture"
   default-executor))

(def default-request
  (provider/request
   "broker-request-default-bare"
   "fixture"
   "pull"
   nil
   {}))

(def default-result-one
  (broker/execute default-broker default-request))

(def default-result-two
  (broker/execute default-broker default-request))

(def nil-store-runtime
  (work/local-runtime
   {:work/store nil
    :work/registry nil}))

(def configured-bare-executions (atom 0))

(defn configured-bare-executor
  [request context]
  (swap! configured-bare-executions inc)
  (fixture-executor request context))

(def configured-bare-broker
  (broker/bind
   (broker/create
    fixture-registry
    {:work/runtime nil-store-runtime})
   "fixture"
   configured-bare-executor))

(def configured-bare-request
  (provider/request
   "broker-request-configured-bare"
   "fixture"
   "pull"
   nil
   {}))

(def configured-bare-result-one
  (broker/execute configured-bare-broker configured-bare-request))

(def configured-bare-result-two
  (broker/execute configured-bare-broker configured-bare-request))

(defn fails?
  [function]
  (try
    (function)
    false
    (catch Throwable error
      true)))

[(test-check
  "provider executors bind by registered provider ID"
  (broker/bound? bound-broker "fixture")
  true)
 (test-check
  "provider executors remain canonical Work steps"
  (get (broker/executor-spec bound-broker "fixture") :op)
  :step)
 (test-check
  "provider acquisition is a step-pure-step Work chain"
  [(get acquisition-spec :op)
   acquisition-operations]
  [:chain [:step :pure :step]])
 (test-check
  "provider brokers default to the store-free Work evaluator"
  [(broker/work-runtime default-broker)
   (broker/managed? default-broker)
   (get (broker/status default-broker) "workMode")]
  [nil false :bare])
 (test-check
  "default bare execution retains no managed replay state"
  [(deref default-executions)
   (= default-result-one default-result-two)]
  [2 true])
 (test-check
  "a canonical nil-store Runtime remains genuinely bare"
  [(work/canonical-runtime? nil-store-runtime)
   (broker/managed? configured-bare-broker)
   (get (broker/status configured-bare-broker) "workMode")
   (deref configured-bare-executions)
   (= configured-bare-result-one configured-bare-result-two)]
  [true false :bare 2 true])
 (test-check
  "provider execution preserves request identity"
  (get (broker/execute bound-broker pull-request) "requestId")
  "broker-request-1")
 (test-check
  "provider execution preserves accepted checkpoints"
  (get
   (get
    (broker/execute
     bound-broker
     (provider/request
      "broker-request-2"
      "fixture"
      "pull"
      nil
      {}))
    "checkpoint")
   "generation")
  1)
 (test-check
  "undeclared provider operations fail closed"
  (fails?
   (fn []
     (broker/execute
      bound-broker
      (provider/request
       "broker-request-delete"
       "fixture"
       "delete"
       nil
       {}))))
  true)
 (test-check
  "registered providers require an executor binding"
  (fails?
   (fn []
     (broker/execute
      (broker/create fixture-registry)
      pull-request)))
  true)
 (test-check
  "credential fields are rejected from provider requests"
  (fails?
   (fn []
     (broker/execute
      bound-broker
      (provider/request
       "broker-request-secret"
       "fixture"
       "pull"
       nil
       {"access_token" "secret"}))))
  true)
 (test-check
  "broker status separates registered and bound providers"
  (get (broker/status bound-broker) "boundProviders")
  ["fixture"])]
