(ns historia.provider-broker-test
  (:require [historia.core.provider :as provider]
            [historia.provider.broker :as broker]
            [historia.provider.observation :as observation]))

(def fixture-descriptor
  (provider/descriptor
   "fixture"
   "0-alpha"
   ["discover" "pull" "observe" "status"]
   ["fixture.document"]
   ["document"]
   {"readOnly" true}))

(def fixture-registry
  (provider/register
   (provider/create-registry)
   fixture-descriptor))

(defn fixture-executor
  [request context]
  (observation/result
   request
   [(observation/observation
     "fixture:document-1:revision-1"
     "fixture.document"
     "document-1"
     "revision-1"
     "2026-08-19T12:00:00Z"
     "application/json"
     "{\"answer\":42}"
     {"title" "Fixture"})]
   {"generation" 1
    "cursor" "document-1"}
   {"claimed" true
    "evidence" "fixture"}
   []))

(def bound-broker
  (broker/bind
   (broker/create fixture-registry)
   "fixture"
   fixture-executor))

(def pull-request
  (provider/request
   "broker-request-1"
   "fixture"
   "pull"
   nil
   {"source" "fixture"}))

(defn fails?
  [function]
  (try
    (function)
    false
    (catch Throwable error
      true)))

(std.lib.test/print-results
 [(std.lib.test/check
   "provider executors bind by registered provider ID"
   (broker/bound? bound-broker "fixture")
   true)
  (std.lib.test/check
   "provider executors are represented as checkpointed work steps"
   (get (broker/executor-spec bound-broker "fixture") :op)
   :step)
  (std.lib.test/check
   "provider execution preserves request identity"
   (get (broker/execute bound-broker pull-request) "requestId")
   "broker-request-1")
  (std.lib.test/check
   "provider execution preserves accepted checkpoints"
   (get
    (get
     (broker/execute
      bound-broker
      (provider/request
       "broker-request-2"
       "fixture"
       "pull"
       nil
       {}))
     "checkpoint")
    "generation")
   1)
  (std.lib.test/check
   "undeclared provider operations fail closed"
   (fails?
    (fn []
      (broker/execute
       bound-broker
       (provider/request
        "broker-request-delete"
        "fixture"
        "delete"
        nil
        {}))))
   true)
  (std.lib.test/check
   "registered providers require an executor binding"
   (fails?
    (fn []
      (broker/execute
       (broker/create fixture-registry)
       pull-request)))
   true)
  (std.lib.test/check
   "credential fields are rejected from provider requests"
   (fails?
    (fn []
      (broker/execute
       bound-broker
       (provider/request
        "broker-request-secret"
        "fixture"
        "pull"
        nil
        {"access_token" "secret"}))))
   true)
  (std.lib.test/check
   "broker status separates registered and bound providers"
   (get (broker/status bound-broker) "boundProviders")
   ["fixture"])])
