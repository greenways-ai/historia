(ns historia.provider-broker-test
  (:require [historia.core.provider :as provider]
            [historia.provider.broker :as broker]
            [historia.provider.observation :as observation]
            [work.base :as work]))

(def fixture-descriptor
  (provider/descriptor
   "fixture"
   "0-alpha"
   ["discover" "pull" "observe" "status"]
   ["fixture.document"]
   ["document"]
   {"readOnly" true}))

(def fixture-registry
  (provider/register
   (provider/create-registry)
   fixture-descriptor))

(defn fixture-executor
  [request context]
  (observation/result
   request
   [(observation/observation
     "fixture:document-1:revision-1"
     "fixture.document"
     "document-1"
     "revision-1"
     "2026-08-19T12:00:00Z"
     "application/json"
     "{\"answer\":42}"
     {"title" "Fixture"})]
   {"generation" 1
    "cursor" "document-1"}
   {"claimed" true
    "evidence" "fixture"}
   []))

(def bound-broker
  (broker/bind
   (broker/create fixture-registry)
   "fixture"
   fixture-executor))

(def pull-request
  (provider/request
   "broker-request-1"
   "fixture"
   "pull"
   nil
   {"source" "fixture"}))

(def acquisition-spec
  (broker/acquisition-spec bound-broker "fixture"))

(def acquisition-operations
  (vec
   (map
    (fn [child]
      (get (work/work-spec child) :op))
    (:children acquisition-spec))))

(def replay-executions (atom 0))

(defn replay-executor
  [request context]
  (swap! replay-executions inc)
  (fixture-executor request context))

(def replay-broker
  (broker/bind
   (broker/create fixture-registry)
   "fixture"
   replay-executor))

(def replay-request
  (provider/request
   "broker-request-replay"
   "fixture"
   "pull"
   nil
   {}))

(def replay-result-one
  (broker/execute replay-broker replay-request))

(def replay-result-two
  (broker/execute replay-broker replay-request))

(def bare-executions (atom 0))

(defn bare-executor
  [request context]
  (swap! bare-executions inc)
  (fixture-executor request context))

(def bare-broker
  (broker/bind
   (broker/create fixture-registry {:work/runtime nil})
   "fixture"
   bare-executor))

(def bare-request
  (provider/request
   "broker-request-bare"
   "fixture"
   "pull"
   nil
   {}))

(def bare-result-one
  (broker/execute bare-broker bare-request))

(def bare-result-two
  (broker/execute bare-broker bare-request))

(defn fails?
  [function]
  (try
    (function)
    false
    (catch Throwable error
      true)))

[(test-check
  "provider executors bind by registered provider ID"
  (broker/bound? bound-broker "fixture")
  true)
 (test-check
  "provider executors remain canonical Work steps"
  (get (broker/executor-spec bound-broker "fixture") :op)
  :step)
 (test-check
  "provider acquisition is a step-pure-step Work chain"
  [(get acquisition-spec :op)
   acquisition-operations]
  [:chain [:step :pure :step]])
 (test-check
  "provider brokers default to the canonical durable Runtime map"
  [(work/canonical-runtime? (broker/work-runtime bound-broker))
   (get (broker/status bound-broker) "workMode")]
  [true :durable])
 (test-check
  "managed provider execution replays one completed request"
  [(deref replay-executions)
   (= replay-result-one replay-result-two)]
  [1 true])
 (test-check
  "explicit bare execution retains no managed replay state"
  [(broker/managed? bare-broker)
   (deref bare-executions)
   (= bare-result-one bare-result-two)]
  [false 2 true])
 (test-check
  "provider execution preserves request identity"
  (get (broker/execute bound-broker pull-request) "requestId")
  "broker-request-1")
 (test-check
  "provider execution preserves accepted checkpoints"
  (get
   (get
    (broker/execute
     bound-broker
     (provider/request
      "broker-request-2"
      "fixture"
      "pull"
      nil
      {}))
    "checkpoint")
   "generation")
  1)
 (test-check
  "undeclared provider operations fail closed"
  (fails?
   (fn []
     (broker/execute
      bound-broker
      (provider/request
       "broker-request-delete"
       "fixture"
       "delete"
       nil
       {}))))
  true)
 (test-check
  "registered providers require an executor binding"
  (fails?
   (fn []
     (broker/execute
      (broker/create fixture-registry)
      pull-request)))
  true)
 (test-check
  "credential fields are rejected from provider requests"
  (fails?
   (fn []
     (broker/execute
      bound-broker
      (provider/request
       "broker-request-secret"
       "fixture"
       "pull"
       nil
       {"access_token" "secret"}))))
  true)
 (test-check
  "broker status separates registered and bound providers"
  (get (broker/status bound-broker) "boundProviders")
  ["fixture"])]
