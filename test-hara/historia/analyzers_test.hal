(ns historia.analyzers-test
  (:require [historia.analyzers :as analyzers]))

(std.lib.test/print-results
 [(std.lib.test/check
   "the application registers all four analyser workers"
   (count analyzers/descriptors)
   4)
  (std.lib.test/check
   "the JavaScript family has its TypeScript worker"
   (analyzers/command "typescript")
   ["bun" "analyzers/typescript/src/analyzer.js"])
  (std.lib.test/check
   "the Python family has its Python worker"
   (analyzers/command "python")
   ["python3" "analyzers/python/src/analyzer.py"])
  (std.lib.test/check
   "the Clojure family has its Babashka worker"
   (analyzers/command "clojure")
   ["bb"
    "-cp"
    "analyzers/clojure/src"
    "-m"
    "greenways-historian.analyzer"])
  (std.lib.test/check
   "the Hara family has its Hara worker launcher"
   (analyzers/command "hara")
   ["analyzers/hara/bin/historia-hara-analyzer"])
  (std.lib.test/check
   "unknown languages do not acquire process authority"
   (analyzers/command "unknown")
   nil)])
