{
  "manifest_version": 3,
  "name": "Historia for ChatGPT",
  "version": "0.3.0",
  "description": "Search and sync a local Git-native ChatGPT history, build bounded context, and hand prompts to ChatGPT without scraping or private APIs.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "tabs"
  ],
  "background": {
    "scripts": [
      "src/background.js"
    ],
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Historia for ChatGPT",
    "default_popup": "src/popup.html"
  },
  "options_page": "src/options.html",
  "browser_specific_settings": {
    "gecko": {
      "id": "historia-collect@greenways.ai",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity"
        ]
      }
    }
  }
}
