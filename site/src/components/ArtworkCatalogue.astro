---
import ThemedArtwork from "@greenways-ai/visual-language/ThemedArtwork.astro";
const concepts=["raven-library","evidence-chamber","index-gallery","inquiry-desk","archive-vault","constellation-of-sources","comparison-corridor","illuminated-manuscript-room","observation-balcony","nocturnal-roost"];
const base=`${import.meta.env.BASE_URL.replace(/\/+$/,"")}/`;
---
<section class="world-catalogue"><header><p class="technical-kicker">02 · Rooms of inquiry</p><h2>Ten places for wisdom,<br/>evidence and knowledge.</h2></header><div>{concepts.map((concept)=><article><ThemedArtwork light={`${base}artwork/historia/${concept}-day.svg`} dark={`${base}artwork/historia/${concept}-night.svg`} lightMobile={`${base}artwork/historia/${concept}-day-mobile.svg`} darkMobile={`${base}artwork/historia/${concept}-night-mobile.svg`} lightAlt={`${concept.replaceAll("-"," ")} by day`} darkAlt={`${concept.replaceAll("-"," ")} at night`}/><h3>{concept.replaceAll("-"," ")}</h3></article>)}</div></section>
<style>.world-catalogue{width:min(100% - 3rem,1280px);margin:80px auto}.world-catalogue h2{font:400 clamp(3rem,7vw,6rem)/.9 Georgia,serif}.world-catalogue>div{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}.world-catalogue article{overflow:hidden;border:1px solid var(--sl-color-hairline);background:var(--sl-color-bg-nav)}.world-catalogue article>div{aspect-ratio:16/9}.world-catalogue h3{margin:0;padding:15px;text-transform:capitalize}@media(max-width:680px){.world-catalogue{width:calc(100% - 1.5rem)}.world-catalogue>div{grid-template-columns:1fr}.world-catalogue article>div{aspect-ratio:3/4}}</style>
