---
import ThemedArtwork from "@greenways-ai/visual-language/ThemedArtwork.astro";
const base = `${import.meta.env.BASE_URL.replace(/\/+$/, "")}/`;
---
<section class="historian-hero">
  <ThemedArtwork class="historian-hero__art" light={`${base}images/historian-raven-day.webp`} dark={`${base}images/historian-raven-night.webp`} lightAlt="A raven perched naturally in a lapis mosaic library" darkAlt="The raven roosting on the same ledge in the moonlit library" position="center" />
  <div class="historian-hero__veil"></div>
  <div class="historian-hero__copy">
    <p class="technical-kicker"><i></i> Open foundation · Apache-2.0</p>
    <h1>Code remembers.</h1>
    <p>Historia walks a repository’s commit DAG, analyzes changed blobs once, tracks symbol lineage, and stores deterministic retrieval documents in SQLite. Git remains the source of truth.</p>
    <div class="hero-links"><a class="action action--raven" href={`${base}getting-started/`}>Start indexing →</a><a class="action" href={`${base}concepts/temporal-index/`}>How it works</a><a class="action" href="https://github.com/greenways-ai/historia">Source ↗</a></div>
    <div class="hero-command"><code>npm install -g @greenways-ai/historian</code><span>Bun · SQLite · Git</span></div>
  </div>
</section>
