---
import ThemedArtwork from "@greenways-ai/visual-language/ThemedArtwork.astro";
const base = `${import.meta.env.BASE_URL.replace(/\/+$/, "")}/`;
---
<section class="historian-hero">
  <ThemedArtwork class="historian-hero__art" light={`${base}images/historian-raven-day.webp`} dark={`${base}images/historian-raven-night.webp`} lightAlt="A raven perched naturally in a lapis mosaic library" darkAlt="The raven roosting on the same ledge in the moonlit library" position="center" />
  <div class="historian-hero__veil"></div>
  <div class="historian-hero__copy">
    <p class="technical-kicker"><i></i> Open foundation · Apache-2.0</p>
    <h1>Work remembers.</h1>
    <p>Historia stores code history and AI conversations as reachable Git objects, builds deterministic SQLite retrieval indexes, and gives local agents bounded context with exact provenance.</p>
    <div class="hero-links"><a class="action action--raven" href={`${base}collect/`}>Collect conversations →</a><a class="action" href={`${base}getting-started/`}>Index code</a><a class="action" href="https://github.com/greenways-ai/historia">Source ↗</a></div>
    <div class="hero-command"><code>historia-collect install --browser chrome</code><span>Git · SQLite · local-first</span></div>
  </div>
</section>
