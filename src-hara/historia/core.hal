(ns historia.core
  (:require [historia.core.analyzer :as analyzer]
            [historia.core.index :as index]
            [historia.provider.github :as github]))

(def schema "historia.core/0-alpha")
(def plan-schema "historia.ingest-plan/0-alpha")

(def stages
  ["provider.observe"
   "artifact.normalize"
   "analysis.dispatch"
   "index.write"
   "link.project"])

(defn describe
  []
  {"schema" schema
   "version" "0.1.0"
   "stages" stages
   "providers" [(github/describe)]
   "analyzers" (analyzer/all)
   "index" (index/describe)})

(defn create
  []
  {"schema" schema
   "index" (index/create)})

(defn ingest-plan
  [artifact]
  {"schema" plan-schema
   "artifactId" (get artifact "id")
   "stages" stages})
