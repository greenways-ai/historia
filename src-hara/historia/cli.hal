(ns historia.cli)

(def version "0.1.0")

(def usage
  "Historia 0.1.0\n\nGit-native private history for conversations, code and issue context.\n\nUsage:\n  historia repl [--resp] [HARA_REPL_OPTIONS]\n  historia repl --eval FORM\n\n  historia core describe\n\n  historia vault init [--vault <path>]\n  historia vault verify [--vault <path>]\n\n  historia --version\n\nEnvironment:\n  HISTORIA_VAULT              Override the default bare Git vault path.\n  HARA_CLI                    Override the native Hara REPL executable.\n  HISTORIA_REPL_SOURCE_ROOT   Override the generated REPL source overlay.\n")

(defn- error
  [message]
  {:action :error
   :message message})

(defn- parse-core
  [arguments]
  (if (< 1 (count arguments))
    (let [command (nth arguments 1)]
      (if (= command "describe")
        (if (= 2 (count arguments))
          {:action :core-describe}
          (error "core describe takes no arguments"))
        (error (str/join "" ["unknown core command: " command]))))
    (error "core requires describe")))

(defn- parse-vault-options
  [arguments index options]
  (if (< index (count arguments))
    (let [argument (nth arguments index)]
      (if (= argument "--vault")
        (if (< (+ index 1) (count arguments))
          (parse-vault-options
           arguments
           (+ index 2)
           (assoc options :vault (nth arguments (+ index 1))))
          (error "--vault requires a path"))
        (if (str/starts-with? argument "--vault=")
          (let [value (str/slice argument 8)]
            (if (str/blank? value)
              (error "--vault requires a path")
              (parse-vault-options
               arguments
               (+ index 1)
               (assoc options :vault value))))
          (if (or (= argument "--help") (= argument "-h"))
            {:action :help}
            (error (str/join "" ["unknown option: " argument]))))))
    options))

(defn parse
  [arguments]
  (if (= 0 (count arguments))
    {:action :help}
    (let [domain (nth arguments 0)]
      (if (or (= domain "--help") (= domain "-h") (= domain "help"))
        {:action :help}
        (if (or (= domain "--version") (= domain "-V"))
          {:action :version}
          (if (= domain "core")
            (parse-core arguments)
            (if (= domain "vault")
              (if (< 1 (count arguments))
                (let [command (nth arguments 1)]
                  (if (= command "init")
                    (parse-vault-options arguments 2 {:action :vault-init})
                    (if (= command "verify")
                      (parse-vault-options arguments 2 {:action :vault-verify})
                      (error (str/join "" ["unknown vault command: " command])))))
                (error "vault requires init or verify"))
              (error (str/join "" ["unknown command: " domain])))))))))
