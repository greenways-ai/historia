(ns historia.main
  (:require [hara.cli.application :as application]
            [historia.cli :as cli]
            [historia.kernel :as kernel]
            [historia.path :as path]
            [historia.vault :as vault]))

(defn- result
  [stdout stderr exit]
  {:hara.app/stdout stdout
   :hara.app/stderr stderr
   :hara.app/exit exit})

(defn- line
  [value]
  (str/join "" [value "\n"]))

(defn- data-result
  [value]
  (result (line (str value)) "" 0))

(defn main
  [request]
  (let [parsed (cli/parse (get request :hara.cli/arguments))
        action (get parsed :action)]
    (if (= action :help)
      (result cli/usage "" 0)
      (if (= action :version)
        (result (line cli/version) "" 0)
        (if (= action :core-describe)
          (data-result kernel/descriptor)
          (if (= action :vault-init)
            (data-result (vault/init (get parsed :vault)))
            (if (= action :vault-verify)
              (data-result (vault/verify (get parsed :vault)))
              (result
               ""
               (str/join
                ""
                ["historia: " (get parsed :message) "\n\n" cli/usage])
               2))))))))

(main application/request)
