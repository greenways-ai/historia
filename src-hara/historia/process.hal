(ns historia.process)

(defn run
  [argv]
  (let [process (os/spawn argv)
        values (deref
                (promise/all
                 [(os/process-stdout process)
                  (os/process-stderr process)
                  (os/process-wait process)]))]
    {:argv argv
     :exit (nth values 2)
     :stdout (str/decode-utf8 (nth values 0))
     :stderr (str/decode-utf8 (nth values 1))}))

(defn run!
  [argv]
  (let [result (run argv)]
    (if (= 0 (:exit result))
      result
      (throw
       (ex :host result :ex/message (str/join
         ""
         ["command failed ("
          (:exit result)
          "): "
          (str/join " " argv)]))))))
