{
  "name": "@greenways-ai/historian",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "bin": {
    "gw-historian": "src/cli.js",
    "historia": "src/historia-cli.js",
    "historia-collect": "src/collect/install-entry.js",
    "historia-collect-host": "src/collect/native-entry.js"
  },
  "files": [
    "src",
    "analyzers",
    "docs",
    "skills",
    "spec",
    "extension",
    "apps",
    "bb.edn",
    "greenways-historian.example.json",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greenways-ai/historia.git"
  },
  "bugs": {
    "url": "https://github.com/greenways-ai/historia/issues"
  },
  "homepage": "https://opensource.greenways.ai/historia/",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "doctor": "bun src/cli.js doctor",
    "build:binary": "bun build --compile src/cli.js --outfile dist/gw-historian",
    "build:historia-binary": "bun build --compile src/historia-cli.js --outfile dist/historia",
    "build:collect-installer-binary": "bun build --compile src/collect/install-entry.js --outfile dist/historia-collect",
    "build:collect-host-binary": "bun build --compile src/collect/native-entry.js --outfile dist/historia-collect-host",
    "release:build": "bun scripts/build-release-artifacts.js",
    "package:validate": "node scripts/validate-package-metadata.js",
    "test": "bun test",
    "chat:test": "bun test test/chat-archive.test.js test/chat-index.test.js test/chat-schema.test.js test/chat-text-graph.test.js test/chat-topic-index.test.js test/chat-neural-index.test.js test/historia-cli.test.js test/object-batch.test.js",
    "collect:test": "bun test test/collect-browser.test.js test/collect-extension-bundle.test.js test/collect-extension-policy.test.js test/collect-install.test.js test/collect-server.test.js test/chatgpt-native-provider.test.js",
    "analyzer:test": "bb -cp analyzers/clojure/src:analyzers/clojure/test analyzers/clojure/test/greenways_historian/analyzer_test.clj",
    "hara:build": "cargo build --release --manifest-path analyzers/hara/Cargo.toml",
    "hara:test": "cargo test --manifest-path analyzers/hara/Cargo.toml",
    "conformance": "bun src/cli.js analyzer check bb -cp analyzers/clojure/src -m greenways-historian.analyzer",
    "conformance:hara": "bun src/cli.js analyzer check analyzers/hara/target/release/historia-hara-analyzer",
    "conformance:typescript": "bun src/cli.js analyzer check bun analyzers/typescript/src/analyzer.js --fixture spec/conformance/typescript.json",
    "conformance:python": "bun src/cli.js analyzer check python3 analyzers/python/src/analyzer.py --fixture spec/conformance/python.json",
    "analyzer:shape": "bun benchmarks/clojure-analyzers.js --shape-only --files 0 --definitions 0",
    "benchmark:clojure-analyzers": "bun benchmarks/clojure-analyzers.js",
    "benchmark:clojure-analyzer-matrix": "bun benchmarks/clojure-analyzer-matrix.js",
    "benchmark": "bun benchmarks/index.js",
    "benchmark:validate": "bun scripts/validate-large-history.js",
    "fixture:large": "bun benchmarks/generate-history-fast.js",
    "fixture:typescript": "bun benchmarks/generate-typescript-history.js",
    "fixture:validate:typescript": "bun scripts/validate-typescript-history.js",
    "check": "bun test && bun run package:validate && bun run analyzer:test && bb run analyzer:kondo:test",
    "fixture:validate": "bun scripts/validate-fixture.js",
    "collect:serve": "bun src/historia-cli.js collect serve"
  },
  "engines": {
    "bun": ">=1.2.18"
  },
  "dependencies": {
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "ajv": "^8.20.0"
  }
}
